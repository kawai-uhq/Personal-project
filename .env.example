# Set these in Vercel: Project -> Settings -> Environment Variables.

# Server only (never exposed to the browser). TMDB "API Read Access Token".
TMDB_TOKEN=

# Optional login + sync. Both values are public by design. Leave empty for a local-only site.
# Set VITE_SIGNIN_COMING_SOON=true to keep showing the "coming soon" notice even when the keys are set.
VITE_SIGNIN_COMING_SOON=
# Never use the service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). Shows "Verify you are human" on sign-in and sign-up.
# Put the matching SECRET key in Supabase: Authentication -> Attack Protection -> Captcha protection -> Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Shown on the About / Terms / Privacy / Takedown pages (for example hello@yourdomain.com)
VITE_CONTACT_EMAIL=
