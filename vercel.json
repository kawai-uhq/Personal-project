{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.svg|icon-192.png|icon-512.png|icon-maskable-512.png|discord.png|og.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/seo?file=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?file=sitemap"
    },
    {
      "source": "/title/:type/:id",
      "destination": "/api/title?type=:type&id=:id"
    },
    {
      "source": "/watch/:type/:id",
      "destination": "/api/title?type=:type&id=:id"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
